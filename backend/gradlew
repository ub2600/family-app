#!/bin/sh
# Gradle wrapper script - downloads and runs Gradle
# To use: chmod +x gradlew && ./gradlew bootRun

GRADLE_VERSION=8.5
GRADLE_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
GRADLE_HOME="${HOME}/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}-bin"

if [ ! -d "$GRADLE_HOME" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    mkdir -p "$GRADLE_HOME"
    curl -L -o "/tmp/gradle-${GRADLE_VERSION}-bin.zip" "$GRADLE_URL"
    unzip -q "/tmp/gradle-${GRADLE_VERSION}-bin.zip" -d "$GRADLE_HOME"
    rm "/tmp/gradle-${GRADLE_VERSION}-bin.zip"
fi

exec "$GRADLE_HOME/gradle-${GRADLE_VERSION}/bin/gradle" "$@"
